# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=aarogya
POSTGRES_PASSWORD=aarogya
POSTGRES_DB=aarogya
DATABASE_URL=postgresql+asyncpg://aarogya:aarogya@localhost:5432/aarogya

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO / S3 ──────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-32-random-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:8000
OTP_DEV_MODE=true
OTP_DEV_CODE=123456

# ─── AI Provider Keys ────────────────────────────────────────────────────────
# Primary chat LLM — NVIDIA NIM (Nemotron-3.5)
# Get from: https://build.nvidia.com/  →  API Key
NVIDIA_API_KEY=nvapi-...

# Streaming LLM + Whisper STT — Groq (REQUIRED for voice features)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional fallback providers
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ─── LiveKit (Voice sessions) ─────────────────────────────────────────────────
# Create a free project at: https://cloud.livekit.io
# Or run LiveKit server locally: docker run -p 7880:7880 livekit/livekit-server --dev
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIfoobar
LIVEKIT_API_SECRET=your-livekit-secret

# ─── Telegram Bot (Xomni Telegram integration) ────────────────────────────────
# Create a bot with @BotFather on Telegram → /newbot → copy token
# Users can also set this per-user in Profile page
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# ─── LLM Cost Guardrails ─────────────────────────────────────────────────────
AI_COST_CEILING_USD_PER_MONTH=10.00
AI_QUERIES_PER_DAY_FREE=30

# ─── Ollama (optional local LLM) ─────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
