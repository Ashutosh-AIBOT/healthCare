# Copy this file to .env for local development, or create these variables in
# your hosting provider. Never commit .env or paste real secrets into Git.

# -----------------------------------------------------------------------------
# Runtime and URLs
# -----------------------------------------------------------------------------
APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=https://app.example.com
# Server-side URL used by the Next.js proxy. Keep this private/internal when possible.
API_INTERNAL_URL=https://api.example.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector
# -----------------------------------------------------------------------------
# Local Docker example:
POSTGRES_USER=aarogya
POSTGRES_PASSWORD=replace-local-password
POSTGRES_DB=aarogya
DATABASE_URL=postgresql+asyncpg://aarogya:replace-local-password@localhost:5432/aarogya

# Production example (use the URL generated by Railway or your Postgres provider):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>?ssl=require
# Optional separate URL used by the deployment migration step. If unset, the app uses DATABASE_URL.
MIGRATE_DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Use rediss:// for a TLS Redis such as Upstash. Use redis:// for local Docker Redis.
REDIS_URL=rediss://default:<password>@<redis-host>:6379
# If using Upstash REST for another integration, these are optional. The backend's
# cache/session code uses REDIS_URL, not the REST variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Authentication, cookies, and development OTP
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_DEV_MODE=false
OTP_DEV_CODE=
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=3
PENDING_REGISTRATION_TTL_MINUTES=30
AUTH_LOGIN_RATE_LIMIT=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Email / OTP delivery
# -----------------------------------------------------------------------------
# Required for production email OTP. For local development use MailHog:
# SMTP_HOST=mailhog
# SMTP_PORT=1025
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Aarogya
SMTP_FROM_ADDRESS=noreply@example.com

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
# Configure at least one provider supported by the gateway. NVIDIA is the primary
# provider in this project; Groq is needed for voice/STT features.
NVIDIA_API_KEY=
LLM_API_KEY=
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
GEMINI_API_KEY=

# Cost controls
AI_COST_CEILING_USD_PER_MONTH=10.00
AI_QUERIES_PER_DAY_FREE=30

# Optional local fallback
OLLAMA_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# LiveKit voice sessions (optional unless voice features are enabled)
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Telegram integration (optional, but required for Telegram agents)
# -----------------------------------------------------------------------------
# Global fallback bot token. Users may also connect their own bot token in the app.
TELEGRAM_BOT_TOKEN=
# Public HTTPS API origin only, for example https://api.example.com.
# The backend appends /api/v1/integrations/telegram/webhook/{secret}.
TELEGRAM_WEBHOOK_URL=https://api.example.com

# -----------------------------------------------------------------------------
# Local-only convenience values
# -----------------------------------------------------------------------------
# Set this only in a local development .env. Never use it in production.
# NEXT_TELEMETRY_DISABLED=1
